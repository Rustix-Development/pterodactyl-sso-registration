{
    "$schema": "./node_modules/@pterodactyl/sdk/manifest.schema.json",
    "id": "registration",
    "name": "Registration",
    "version": "1.0.0",
    "description": "Let people create their own panel account from the login page, with email verification, allowed and blocked email domains, terms of service, and sign-up and sign-in with Discord, GitHub, Google, Microsoft, GitLab, Twitch, Steam or any OpenID Connect provider.",
    "author": "RustixDev",
    "icon": "user-plus",
    "requires": {
        "panel": "^2.0.0-dev",
        "sdk": ">=2.0.0-beta.6 <3.0",
        "php": "^8.3"
    },
    "provider": "RustixDev\\Registration\\RegistrationProvider",
    "routes": {
        "root": [
            "register"
        ]
    },
    "ui": {
        "entry": "dist/client.js",
        "mode": "native",
        "prefix": "rxrg",
        "screens": [
            {
                "id": "verify",
                "area": "account",
                "path": "verify-email"
            },
            {
                "id": "connections",
                "area": "account",
                "path": "connected-accounts",
                "nav": {
                    "label": "Connected accounts",
                    "icon": "link"
                }
            }
        ]
    }
}
